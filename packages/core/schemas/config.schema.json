{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accord.dev/schemas/config.schema.json",
  "title": "accord config.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["accord", "profile", "tracker", "design", "roles", "runtimes"],
  "$defs": {
    "subject": {
      "type": "string",
      "allOf": [
        { "pattern": "^[^{}]*\\{id\\}[^{}]*$" },
        { "pattern": "^(?!\\{id\\}$)" },
        { "pattern": "^[^\\r\\n]*$" },
        { "pattern": "^(?!-)" },
        { "pattern": "^(?!\\s)" },
        { "pattern": "\\S$" }
      ]
    }
  },
  "properties": {
    "accord": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "profile": { "type": "string", "enum": ["build", "maintain"] },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "enum": ["none", "github-issues"] },
        "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" }
      },
      "if": { "properties": { "adapter": { "const": "github-issues" } }, "required": ["adapter"] },
      "then": { "required": ["repo"] }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": { "tokens": { "type": "string" } }
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["ba", "dev", "designer"] },
      "allOf": [{ "contains": { "const": "ba" } }, { "contains": { "const": "dev" } }]
    },
    "runtimes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "string", "enum": ["claude", "codex", "cursor", "copilot"] }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report"],
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "affected": { "type": "string", "minLength": 1 },
        "full": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "type": "string", "enum": ["human", "outcome"] } }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(scout|auditor|architect|critic|planner|executor|reviewer|reviewer\\.final|verifier|debugger)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": { "type": "string", "pattern": "^(haiku|sonnet|opus|inherit|claude-[a-z0-9-]+)$" },
            "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fix_round_tier_up"],
      "properties": { "fix_round_tier_up": { "type": "string", "pattern": "^[1-5]$" } }
    },
    "stale_days": { "type": "string", "pattern": "^[1-9][0-9]{0,3}$" },
    "people": {
      "type": "object",
      "propertyNames": { "pattern": "^[^@\\s]+@[^@\\s]+$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Z]{2,4}$" }
    },
    "legacy_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "branch": {
      "type": "string",
      "allOf": [
        { "pattern": "^[^{}]*\\{id\\}[^{}]*$" },
        { "pattern": "^(?!\\{id\\}$)" },
        { "pattern": "^(?:[A-Za-z0-9._/-]|\\{id\\})+$" },
        { "pattern": "^(?![-/])" },
        { "pattern": "[^/.]$" },
        { "pattern": "^(?!.*\\.\\.)" },
        { "pattern": "^(?!.*//)" },
        { "pattern": "^(?!(?:.*/)?\\.)" },
        { "pattern": "^(?!.*\\.lock(?:/|$))" },
        { "pattern": "^(?:t/\\{id\\}$|(?!t/))" }
      ]
    },
    "setup": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "commits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trailers": { "type": "string", "enum": ["allow", "forbid"] },
        "subjects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claim": { "$ref": "#/$defs/subject" },
            "plan_ready": { "$ref": "#/$defs/subject" },
            "plan_round": { "$ref": "#/$defs/subject" },
            "approach_round": { "$ref": "#/$defs/subject" },
            "intent": { "$ref": "#/$defs/subject" },
            "ticket_understood": { "$ref": "#/$defs/subject" },
            "ticket_question": { "$ref": "#/$defs/subject" },
            "scout": { "$ref": "#/$defs/subject" },
            "drop": { "$ref": "#/$defs/subject" },
            "rebind": { "$ref": "#/$defs/subject" },
            "ruleset_backfill": { "$ref": "#/$defs/subject" }
          }
        },
        "legacy_subjects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claim": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "plan_ready": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "plan_round": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "approach_round": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "intent": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "ticket_understood": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "ticket_question": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "scout": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "drop": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "rebind": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } },
            "ruleset_backfill": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subject" } }
          }
        }
      }
    },
    "generated": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "allOf": [ { "pattern": "^[A-Za-z0-9._@-](?:[A-Za-z0-9._@/ -]*[A-Za-z0-9._@/-])?$" }, { "pattern": "^(?!(?:.*/)?\\.\\.(?:/|$))" }, { "pattern": "^(?!(?:.*/)?\\.(?:/|$))" }, { "pattern": "^(?!.*//)" } ] } },
    "sensitive": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "allOf": [ { "pattern": "^[A-Za-z0-9._@-](?:[A-Za-z0-9._@/ -]*[A-Za-z0-9._@/-])?$" }, { "pattern": "^(?!(?:.*/)?\\.\\.(?:/|$))" }, { "pattern": "^(?!(?:.*/)?\\.(?:/|$))" }, { "pattern": "^(?!.*//)" } ] } }
    },
    "disposable": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "allOf": [ { "pattern": "^[^/\\\\]+$" }, { "pattern": "^(?!\\.{1,2}$)" } ] } },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merge": { "type": "string", "enum": ["merge", "rebase", "squash"] },
        "sync": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" }
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["pattern", "tracker"] },
        "pattern": {
          "type": "string",
          "maxLength": 64,
          "allOf": [
            { "pattern": "^(?:[A-Za-z0-9._-]|\\{type\\}|\\{initials\\}|\\{n\\})+$" },
            { "pattern": "\\{n\\}" },
            { "pattern": "^(?!.*\\{n\\}.*\\{n\\})" },
            { "pattern": "^(?!.*\\{type\\}.*\\{type\\})" },
            { "pattern": "^(?!.*\\{initials\\}.*\\{initials\\})" },
            { "pattern": "^(?:[A-Za-z0-9]|\\{type\\}|\\{initials\\})" }
          ]
        },
        "types": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "story": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}$" },
            "bug": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}$" },
            "epic": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}$" }
          }
        },
        "projects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,19}$" }
        }
      }
    },
    "strictness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approach": { "type": "string", "pattern": "^[1-9][0-9]?$" },
            "plan": { "type": "string", "pattern": "^[1-9][0-9]?$" },
            "review": { "type": "string", "pattern": "^[1-9][0-9]?$" }
          }
        }
      }
    }
  }
}
