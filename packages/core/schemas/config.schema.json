{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accord.dev/schemas/config.schema.json",
  "title": "accord config.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["accord", "profile", "tracker", "design", "roles", "runtimes"],
  "properties": {
    "accord": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "profile": { "type": "string", "enum": ["build", "maintain"] },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "enum": ["none", "github-issues"] },
        "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" }
      },
      "if": { "properties": { "adapter": { "const": "github-issues" } }, "required": ["adapter"] },
      "then": { "required": ["repo"] }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": { "tokens": { "type": "string" } }
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["ba", "dev", "designer"] },
      "allOf": [{ "contains": { "const": "ba" } }, { "contains": { "const": "dev" } }]
    },
    "runtimes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "string", "enum": ["claude", "codex", "cursor", "copilot"] }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report"],
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "affected": { "type": "string", "minLength": 1 },
        "full": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "type": "string", "enum": ["human", "outcome"] } }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(scout|auditor|architect|critic|planner|executor|reviewer|reviewer\\.final|verifier|debugger)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": { "type": "string", "pattern": "^(haiku|sonnet|opus|inherit|claude-[a-z0-9-]+)$" },
            "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fix_round_tier_up"],
      "properties": { "fix_round_tier_up": { "type": "string", "pattern": "^[1-5]$" } }
    },
    "stale_days": { "type": "string", "pattern": "^[1-9][0-9]{0,3}$" },
    "people": {
      "type": "object",
      "propertyNames": { "pattern": "^[^@\\s]+@[^@\\s]+$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Z]{2,4}$" }
    },
    "legacy_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "branch": {
      "type": "string",
      "allOf": [
        { "pattern": "^[^{}]*\\{id\\}[^{}]*$" },
        { "pattern": "^(?!\\{id\\}$)" },
        { "pattern": "^(?:[A-Za-z0-9._/-]|\\{id\\})+$" },
        { "pattern": "^(?![-/])" },
        { "pattern": "[^/.]$" },
        { "pattern": "^(?!.*\\.\\.)" },
        { "pattern": "^(?!.*//)" },
        { "pattern": "^(?!(?:.*/)?\\.)" },
        { "pattern": "^(?!.*\\.lock(?:/|$))" },
        { "pattern": "^(?:t/\\{id\\}$|(?!t/))" }
      ]
    }
  }
}
