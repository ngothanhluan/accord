{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/accord.mjs",
              "0.20.1",
              "hook",
              "session-start"
            ],
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/accord.mjs",
              "0.20.1",
              "hook",
              "session-resume"
            ],
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "accord-.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/accord.mjs",
              "0.20.1",
              "hook",
              "subagent-start"
            ]
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "accord",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/accord.mjs",
              "0.20.1",
              "hook",
              "prompt-expansion"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/accord.mjs",
              "0.20.1",
              "hook",
              "pre-tool-use"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/accord.mjs",
              "0.20.1",
              "hook",
              "pre-tool-use"
            ],
            "if": "Write(**/accord/tickets/*/verification.md)"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/accord.mjs",
              "0.20.1",
              "hook",
              "pre-tool-use"
            ],
            "if": "Edit(**/accord/tickets/*/verification.md)"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/accord.mjs",
              "0.20.1",
              "hook",
              "pre-tool-use"
            ],
            "if": "MultiEdit(**/accord/tickets/*/verification.md)"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "accord": {
      "source": {
        "source": "directory",
        "path": "./.claude/accord-panel"
      }
    }
  },
  "enabledPlugins": {
    "accord-panel@accord": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
