{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.3.0 hook session-start"
          }
        ]
      },
      {
        "matcher": "resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.3.0 hook session-resume"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "accord-.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.3.0 hook subagent-start"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "accord",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.3.0 hook prompt-expansion"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "accord": {
      "source": {
        "source": "directory",
        "path": "./.claude/accord-panel"
      }
    }
  },
  "enabledPlugins": {
    "accord-panel@accord": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
