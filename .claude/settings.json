{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.4.1 hook session-start",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.4.1 hook session-resume",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "accord-.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.4.1 hook subagent-start"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "accord",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.4.1 hook prompt-expansion"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @accord-dev/accord@0.4.1 hook pre-tool-use"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "accord": {
      "source": {
        "source": "directory",
        "path": "./.claude/accord-panel"
      }
    }
  },
  "enabledPlugins": {
    "accord-panel@accord": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
